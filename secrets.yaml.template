# Copy this file to secrets.yaml and fill in your real values.
# secrets.yaml itself is gitignored -- never commit it.
#
# `make secrets` creates secrets.yaml from this template and generates fresh
# values for the two crypto lines automatically; you only fill in Wi-Fi.

wifi_ssid: "WIFI_SSID"
wifi_password: "WIFI_PASSWORD"

# Must be a base64-encoded 32-byte key. Generate your own with:
#   python3 -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
sprinkler_api_key: "API_KEY"

sprinkler_ota_password: "OTA_PASSWORD"

# The timezone is required for the on-device scheduler: the ESP32 owns the
# schedule and must resolve local time itself, with no network (FR-1.3).
# Latitude/longitude are not used yet -- they are here for the sunrise-relative
# start times in v2, which are computable offline from the date alone.
# Treated as sensitive for the same reason the pool controller does: together
# they reveal the property's approximate location.
sprinkler_latitude: "LATITUDE"
sprinkler_longitude: "LONGITUDE"
sprinkler_timezone: "TIMEZONE"   # IANA zone, e.g. "Europe/Paris"
